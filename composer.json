{
    "name": "uadevteampackages/imitator",
    "description": "Local-only Entra user imitation for Laravel apps",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "entra",
        "impersonation",
        "imitator",
        "edas"
    ],
    "require": {
        "php": "^8.2",
        "illuminate/auth": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/session": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Uadevteampackages\\Imitator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Uadevteampackages\\Imitator\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Uadevteampackages\\Imitator\\ImitatorServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint --parallel",
        "lint:check": "pint --parallel --test"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
